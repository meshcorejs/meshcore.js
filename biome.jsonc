{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!pnpm-lock.yaml",
      "!docs",
      "!apps/docs/.next",
      "!apps/docs/.source",
      "!apps/docs/next-env.d.ts",
      "!apps/docs/content/docs/*/reference",
      "!apps/docs/**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noVoidTypeReturn": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["apps/docs/**"],
      "linter": { "domains": { "next": "recommended", "react": "recommended" } }
    }
  ]
}
