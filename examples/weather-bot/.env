MESH_SERIAL=/dev/ttyACM0
# Where the club hikes from: advertised by the radio and used for the forecast (Open-Meteo, no key needed)
CLUB_LAT=43.6045
CLUB_LON=1.4442
# Channel of the morning bulletin
TRAIL_BOT_CHANNEL=#trail
# Comma-separated public keys (full keys or 12+ hex prefixes)
OWNER_KEYS=
ORGANIZER_KEYS=
# Where hikes.json is written
TRAIL_BOT_DATA=./data
