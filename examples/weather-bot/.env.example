# Companion radio over USB (main.ts shows the TCP alternative)
MESH_SERIAL=/dev/ttyACM0
# Location advertised by the radio and used for the forecast (Open-Meteo, no key needed)
WEATHER_LAT=43.6045
WEATHER_LON=1.4442
WEATHER_TIMEZONE=Europe/Paris
# Channel of the morning bulletin, it must exist on the radio. Quote it, an unquoted # starts a comment
WEATHER_BOT_CHANNEL="#weather"
# Comma-separated public keys (full keys or 12+ hex prefixes) allowed to run /plugins and /jobs
OWNER_KEYS=
