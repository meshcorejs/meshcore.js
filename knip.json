{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "ignoreDependencies": ["serialport"],
  "workspaces": {
    ".": {
      "project": ["*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "examples/*": {
      "entry": ["src/{permissions,roles,commands,events,jobs,plugins}/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/client": {
      "entry": ["test/fixtures/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/testing": {
      "entry": ["test/fixtures/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
