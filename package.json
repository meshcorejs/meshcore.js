{
  "name": "@meshcorejs/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter '!@meshcorejs/docs' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:types": "pnpm -r --filter \"./packages/*\" --filter \"./plugins/*\" exec attw --pack . --profile esm-only",
    "test:coverage": "vitest run --coverage",
    "check:publish": "pnpm -r --filter \"./packages/*\" --filter \"./plugins/*\" exec publint",
    "knip": "knip",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "~1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "knip": "^6.37.0",
    "publint": "~0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshcorejs/meshcore.js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Théo Lagache",
    "url": "https://github.com/asuniia"
  }
}
